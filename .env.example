# Which "brain" mini-hermes uses: "claude" or "openai_compat"
LLM_PROVIDER=claude

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- OpenAI-compatible router (OrcaRouter, OpenRouter, etc.) ---
# Fill BASE_URL and API_KEY with the values from your router's console/docs.
# OrcaRouter: https://www.orcarouter.ai/console/catalog?q=free
# OpenRouter: https://openrouter.ai/api/v1
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=qwen/qwen3.8-27b-free

# Optional: if OPENAI_COMPAT_BASE_URL's host is blocked/unreachable via
# normal DNS in your region, pin it to an IP from an alternate resolver
# (a "smart DNS"/unblocking service) instead. TLS still validates normally —
# only which IP the socket connects to changes, scoped to that one host.
# Leave DNS_PIN=false unless you actually need this.
OPENAI_COMPAT_DNS_PIN=false
OPENAI_COMPAT_DNS_SERVERS=111.88.96.50,111.88.96.51

# Root directory the document/code tools are allowed to touch
WORKSPACE_DIR=./workspace
