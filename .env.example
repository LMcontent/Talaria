# Which "brain" Talaria uses: "claude" or "openai_compat"
LLM_PROVIDER=claude

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- OpenAI-compatible router (OrcaRouter, OpenRouter, etc.) ---
# Fill BASE_URL and API_KEY with the values from your router's console/docs.
# OrcaRouter: https://www.orcarouter.ai/console/catalog?q=free
# OpenRouter: https://openrouter.ai/api/v1
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=qwen/qwen3.8-27b-free

# Optional: if OPENAI_COMPAT_BASE_URL's host is blocked/unreachable via
# normal DNS in your region, pin it to an IP from an alternate resolver
# (a "smart DNS"/unblocking service) instead. TLS still validates normally —
# only which IP the socket connects to changes, scoped to that one host.
# Leave DNS_PIN=false unless you actually need this.
OPENAI_COMPAT_DNS_PIN=false
OPENAI_COMPAT_DNS_SERVERS=111.88.96.50,111.88.96.51

# Root directory the document/code tools are allowed to touch
WORKSPACE_DIR=./workspace

# Where conversation history is persisted between CLI runs.
# Defaults to a hidden file inside WORKSPACE_DIR — usually no need to set this.
# MEMORY_FILE=./workspace/.history.json

# Where long-term memory (facts saved via the remember tool) is persisted.
# Injected into the system prompt on every turn. Defaults to a hidden file
# inside WORKSPACE_DIR — usually no need to set this.
# NOTES_FILE=./workspace/.notes.json

# Keep only the most recent N conversation turns to bound request size/cost
# on long-running conversations.
MAX_HISTORY_TURNS=30

# Ask for y/N approval in the terminal before run_python actually executes
# model-generated code. Only set to false if you fully trust the model/provider.
CONFIRM_CODE_EXEC=true

# Starting role — see talaria/roles.py for the built-in list
# (assistant, researcher, coder, analyst). Switch anytime with /role in the CLI.
DEFAULT_ROLE=assistant

# Directory scanned on startup for skill files (*.py defining a top-level
# TOOLS list) — drop a file here to add a new tool without touching
# Talaria itself. See skills/example_time.py.
SKILLS_DIR=./skills

# Web UI (python -m talaria.web) bind address/port. Keep WEB_HOST as
# 127.0.0.1 (localhost-only) unless you specifically intend to expose this
# on your network — run_python/propose_skill can execute code, so anyone
# who can reach this port can execute code with your permissions.
WEB_HOST=127.0.0.1
WEB_PORT=5000

# Optional: once this many tokens (input+output, summed across the whole
# session — including any delegate_task sub-agents and propose_skill's
# security-review calls) have been used, further model calls are refused
# with a clear message instead of continuing to spend. 0 = no limit
# (default). Check current usage anytime with /usage in the CLI, or the
# "Usage" section of the web UI's sidebar.
MAX_SESSION_TOKENS=0

# Optional: $ per 1,000,000 tokens for your specific model/router, used
# only to show an estimated cost alongside the token count above. Talaria
# can't look this up automatically — it varies by provider/router/model,
# and routers like OrcaRouter/OpenRouter serve a large, changing catalog.
# Leave at 0 (default) to just see the raw token count with no cost shown.
TOKEN_PRICE_INPUT_PER_M=0
TOKEN_PRICE_OUTPUT_PER_M=0

# Used by the optional skills/wolfram_alpha.py skill (wolfram_query tool)
# — a free AppID from https://products.wolframalpha.com/api. Leave empty
# to skip that skill; it returns a clear error instead of failing silently
# if left unset. This is a separate quota from your LLM provider, not
# covered by MAX_SESSION_TOKENS.
WOLFRAM_APPID=
